<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Athena launchd daemon. Boot-time system daemon (RunAtLoad + KeepAlive):
  launchd starts it at boot and restarts on crash. Rendered from this
  template by deploy/athena-install.sh; @TOKENS@ are substituted from
  deploy/athena.toml. Logs are written to local files only; a separate
  Vector instance on the Mac tails them and ships one-way to Clio — Athena
  itself initiates no connection to Crete (passive-oracle contract).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>me.goodolclint.athena</string>

  <key>ProgramArguments</key>
  <array>
    <string>@ATHENA_BIN@</string>
    <string>serve</string>
    <string>--host</string>
    <string>@LISTEN_HOST@</string>
    <string>--port</string>
    <string>@LISTEN_PORT@</string>
    <!--BUDGET--><string>--budget-bytes</string><string>@BUDGET_VALUE@</string>
    <!--ENGINE--><string>--engine</string><string>@ENGINE_VALUE@</string>
    <!--MODEL--><string>--model</string><string>@MODEL_VALUE@</string>
  </array>

  <key>UserName</key>
  <string>@ATHENA_USER@</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Standard</string>

  <key>WorkingDirectory</key>
  <string>/usr/local/var/athena</string>
  <key>StandardOutPath</key>
  <string>@LOG_DIR@/athena.out.log</string>
  <key>StandardErrorPath</key>
  <string>@LOG_DIR@/athena.err.log</string>

  <key>SoftResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>8192</integer>
  </dict>
</dict>
</plist>
