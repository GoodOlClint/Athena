.DS_Store
.build/
.swiftpm/*
# …except committed shared schemes (M44.3 needs athena-Package.xcscheme
# to override the auto-generated `codeCoverageEnabled="YES"` and stop
# Swift coverage instrumentation from being baked into the binary).
!.swiftpm/xcode
.swiftpm/xcode/*
!.swiftpm/xcode/xcshareddata
.swiftpm/xcode/xcshareddata/*
!.swiftpm/xcode/xcshareddata/xcschemes
*.xcodeproj
*.xcframework
# Package.resolved IS committed — Athena is a deployed appliance; pinned
# dependency versions make launchd installs reproducible.

# Rust structured-output shim (wired in M3)
rust-shim/target/
# rust-shim/Cargo.lock IS committed — Athena is a deployed appliance;
# pinned Rust deps make the structured-output shim build reproducible.

# Athena local model store / config (never committed; lives in a well-known dir)
.athena/

# Editor/IDE
.vscode/

# Test coverage artifact
default.profraw

# Claude/agent local settings
.claude/

# graphify: commit graphify-out/ so teammates start with the map, but exclude
# per-user cost tracking and the rebuildable cache (graphify team-setup guidance).
graphify-out/cost.json
graphify-out/cache/
# …and the machine-specific interpreter path + dated snapshot copies.
graphify-out/.graphify_python
graphify-out/20*/
# …and the transient rebuild lock/queue files the post-commit hook drops.
graphify-out/.pending_changes
graphify-out/.rebuild.lock

# ChunkHound local semantic index / daemon log
.chunkhound/
